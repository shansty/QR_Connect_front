  {
    "compilerOptions": {
      "target": "ES6",                     
      "module": "CommonJS",      
      "jsx": "react-jsx",              
      "moduleResolution": "node",            
      "strict": true,                       
      "esModuleInterop": true,               
      "forceConsistentCasingInFileNames": true, 
      "skipLibCheck": true,                  
      "outDir": "./dist",                    
      "rootDir": "./src",                    
      "resolveJsonModule": true,            
      "declaration": true,                   
      "sourceMap": true                      
    },
    "include": ["src/**/*"],                 
    "exclude": ["node_modules", "dist"]     
  }